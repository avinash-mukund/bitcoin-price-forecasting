import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
import joblib
import os

def train_linear_regression(df: pd.DataFrame, model_path: str = "models/linear_regression.pkl"):
    """
    Train the best performing model from the research paper (Linear Regression).
    """

    features = ['open', 'high', 'low', 'close', 'volume', 'close_lag1', 'close_ma7', 'daily_return']
    target = 'target'

    X = df[features]
    y = df[target]

    # Time-based split (70% train, 15% validation, 15% test)
    total = len(df)
    train_end = int(total * 0.70)
    val_end = int(total * 0.85)

    X_train, y_train = X.iloc[:train_end], y.iloc[:train_end]
    X_val, y_val = X.iloc[train_end:val_end], y.iloc[train_end:val_end]
    X_test, y_test = X.iloc[val_end:], y.iloc[val_end:]

    # Train model
    model = LinearRegression()
    model.fit(X_train, y_train)

    # Predictions
    y_pred = model.predict(X_test)

    # Evaluation metrics (same as paper)
    mse = mean_squared_error(y_test, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y_test, y_pred)
    r2 = r2_score(y_test, y_pred)

    print("Linear Regression Results (Test Set)")
    print("-" * 40)
    print(f"MSE  : {mse:,.2f}")
    print(f"RMSE : {rmse:,.2f}")
    print(f"MAE  : {mae:,.2f}")
    print(f"R²   : {r2:.4f}")

    # Save model
    os.makedirs(os.path.dirname(model_path), exist_ok=True)
    joblib.dump(model, model_path)
    print(f"\nModel saved to: {model_path}")

    return model, y_test, y_pred
